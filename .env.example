# Run python scripts/configure_local.py to generate real local values.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://kyc_app:REPLACE_APP_PASSWORD@127.0.0.1:5432/kyc
MIGRATION_DATABASE_URL=postgresql+psycopg2://kyc_migrator:REPLACE_MIGRATION_PASSWORD@127.0.0.1:5432/kyc
DEVELOPMENT_API_KEY=REPLACE_WITH_A_GENERATED_SECRET_OF_AT_LEAST_32_CHARACTERS
DEVELOPMENT_ORGANIZATION_ID=REPLACE_WITH_A_UUID4
POSTGRES_PASSWORD=REPLACE_MIGRATION_PASSWORD
KYC_APP_PASSWORD=REPLACE_APP_PASSWORD
SESSION_TTL_SECONDS=900
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# Phase 2 capture pipeline. Keyring "version:base64(32 random bytes)[,older-version:key]".
# The first key encrypts; older keys only decrypt (rotation). Without it, uploads return 503.
CAPTURE_ENCRYPTION_KEYS=local-v1:REPLACE_WITH_BASE64_32_BYTE_KEY
CAPTURE_STORAGE_DIR=var/captures
MAX_CAPTURE_BYTES=10485760
MAX_CAPTURE_PIXELS=40000000
MAX_CAPTURE_ATTEMPTS=20
# Reserved for future approved phases; no external resources are provisioned.
# REDIS_URL=redis://redis:6379/0
# GCP_PROJECT_ID=
# GCS_CAPTURE_BUCKET=
# GCS_BIOMETRIC_BUCKET=
# PUBSUB_TOPIC=
# Phase 3 document extraction. Separate keyring for extracted identity fields (same format),
# plus a base64 32-byte key for document-number lookup hashes. Both or neither.
PII_ENCRYPTION_KEYS=pii-v1:REPLACE_WITH_BASE64_32_BYTE_KEY
PII_HMAC_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
TESSERACT_CMD=tesseract
OCR_LANGUAGES=khm,eng
OCR_TIMEOUT_SECONDS=20
# inline: process right after the last side is accepted. deferred: run scripts/process_documents.py.
DOCUMENT_PROCESSING_MODE=inline
# Phases 8–9 face quality and 1:1 comparison. Use a third, independent keyring.
BIOMETRIC_ENCRYPTION_KEYS=biometric-v1:REPLACE_WITH_BASE64_32_BYTE_KEY
FACE_MODELS_DIR=var/models
MAX_SELFIE_BYTES=5242880
MAX_SELFIE_PIXELS=12000000
MAX_SELFIE_ATTEMPTS=10
# Phase 10 active liveness: challenge lifetime, challenges per session, total upload size for 4–12 frames.
# The policy returns at best REVIEW while LIVENESS_CALIBRATED=false (validate on attack data before enabling).
LIVENESS_CHALLENGE_TTL_SECONDS=120
MAX_LIVENESS_ATTEMPTS=5
MAX_LIVENESS_BYTES=16777216
LIVENESS_POLICY_VERSION=ACTIVE-GEOMETRY-2026.10.1
LIVENESS_CALIBRATED=false
BIOMETRIC_CONSENT_POLICY_VERSION=BIOMETRIC-CONSENT-2026.10.1
# Defaults are uncalibrated; every comparison requires REVIEW regardless of score.
FACE_MATCH_POLICY_VERSION=SFACE-COSINE-UNCALIBRATED-2026.10.1
FACE_MATCH_CALIBRATED=false
FACE_MATCH_PASS_THRESHOLD=0.363
FACE_MATCH_FAIL_THRESHOLD=0.20
# Set only after validation on representative, consented data. Calibration also
# requires a distinct policy version. OpenCV benchmark thresholds are not KYC calibration.
FACE_MATCH_CALIBRATION_REFERENCE=
# Phase 7: optional JSON file {"key-id": "-----BEGIN PUBLIC KEY-----..."} of issuers trusted to sign barcode
# payloads (JWS). Leave unset: signed codes are then reported as present but not verifiable.
# BARCODE_TRUST_STORE=/run/secrets/barcode-trust.json
# Phase 11 ePassport chip. Folder of trusted Country Signing CA certificates (PEM/DER), e.g. extracted
# from the ICAO PKD master list. Unset: chips can be read but never reach NFC_VERIFIED.
# NFC_CSCA_TRUST_STORE=/run/secrets/csca
NFC_CHALLENGE_TTL_SECONDS=120
MAX_NFC_ATTEMPTS=3
MAX_NFC_BYTES=524288
