# Configuration template only. Inject real values from version-pinned Secret Manager secrets.
# Do not put MIGRATION_DATABASE_URL or a development API key into the API deployment.
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg2://kyc_app:INJECT_PASSWORD@db.example.com/kyc?sslmode=verify-full&sslrootcert=/run/secrets/db-ca.pem
CAPTURE_ENCRYPTION_KEYS=capture-v1:INJECT_SEPARATE_BASE64_32_BYTE_KEY
PII_ENCRYPTION_KEYS=pii-v1:INJECT_SEPARATE_BASE64_32_BYTE_KEY
PII_HMAC_KEY=INJECT_SEPARATE_BASE64_32_BYTE_KEY
BIOMETRIC_ENCRYPTION_KEYS=biometric-v1:INJECT_SEPARATE_BASE64_32_BYTE_KEY
WEBHOOK_SECRET_KEYS=webhook-v1:INJECT_SEPARATE_BASE64_32_BYTE_KEY
ALLOWED_HOSTS=kyc.example.com
EXPOSE_API_DOCS=false
ENABLE_CAPTURE_CLIENT=false
REQUIRE_DOCUMENT_CONSENT=true
DOCUMENT_CONSENT_POLICY_VERSION=DOCUMENT-CONSENT-2026.10.1
REVIEWER_TOKEN_MAX_DAYS=90
LOG_FORMAT=json
WEBHOOK_ALLOW_PRIVATE_TARGETS=false
WEBHOOK_DELIVERY_MODE=worker
# Phase 18 capacity settings (docs/architecture-phase18.md). OCR runs in scripts/process_documents.py.
DOCUMENT_PROCESSING_MODE=deferred
WEB_CONCURRENCY=2
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
MAX_CONCURRENT_REQUESTS=0
REQUEST_QUEUE_TIMEOUT_SECONDS=5
CAPTURE_STORAGE_DIR=/var/lib/kyc/captures
FACE_MODELS_DIR=/var/lib/kyc/models
# Deployment blockers: production refuses to start without measured biometric evidence.
FACE_MATCH_CALIBRATION_FILE=/run/secrets/face-calibration.json
LIVENESS_VALIDATION_FILE=/run/secrets/liveness-validation.json
# Either provide the CSCA trust store or switch the NFC level off.
NFC_ENABLED=false
# NFC_CSCA_TRUST_STORE=/run/secrets/csca
# This local storage backend needs a private durable volume. GCS/CMEK is Phase 19.
