  "components": {
    "schemas": {
      "DocumentType": {
        "type": "string",
        "enum": [
          "KH_NATIONAL_ID",
          "KH_PASSPORT",
          "KH_NSSF",
          "PASSPORT",
          "NATIONAL_ID",
          "RESIDENCE_CARD",
          "DRIVING_LICENSE",
          "UNKNOWN"
        ],
        "title": "DocumentType"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SessionCreate": {
        "properties": {
          "user_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "User Id"
          },
          "country": {
            "type": "string",
            "maxLength": 2,
            "minLength": 2,
            "title": "Country"
          },
          "expected_document_type": {
            "$ref": "#/components/schemas/DocumentType"
          },
          "verification_level": {
            "$ref": "#/components/schemas/VerificationLevel",
            "default": "DOCUMENT_FACE_LIVENESS"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "user_id",
          "country",
          "expected_document_type"
        ],
        "title": "SessionCreate"
      },
      "SessionResponse": {
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid",
            "title": "Session Id"
          },
          "organization_id": {
            "type": "string",
            "format": "uuid",
            "title": "Organization Id"
          },
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "country": {
            "type": "string",
            "title": "Country"
          },
          "expected_document_type": {
            "$ref": "#/components/schemas/DocumentType"
          },
          "verification_level": {
            "$ref": "#/components/schemas/VerificationLevel"
          },
          "status": {
            "$ref": "#/components/schemas/SessionStatus"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "organization_id",
          "user_id",
          "country",
          "expected_document_type",
          "verification_level",
          "status",
          "created_at",
          "updated_at",
          "expires_at",
          "version"
        ],
        "title": "SessionResponse"
      },
      "SessionResult": {
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid",
            "title": "Session Id"
          },
          "status": {
            "$ref": "#/components/schemas/SessionStatus"
          },
          "document": {
            "type": "null",
            "title": "Document"
          },
          "identity": {
            "type": "null",
            "title": "Identity"
          },
          "checks": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Checks"
          },
          "decision": {
            "type": "null",
            "title": "Decision"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "status"
        ],
        "title": "SessionResult"
      },
      "SessionStatus": {
        "type": "string",
        "enum": [
          "CREATED",
          "DOCUMENT_REQUIRED",
          "DOCUMENT_PROCESSING",
          "SELFIE_REQUIRED",
          "LIVENESS_REQUIRED",
          "NFC_REQUIRED",
          "PROCESSING",
          "MANUAL_REVIEW",
          "VERIFIED",
          "REJECTED",
          "EXPIRED"
        ],
        "title": "SessionStatus"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VerificationLevel": {
        "type": "string",
        "enum": [
          "DOCUMENT_ONLY",
          "DOCUMENT_FACE",
          "DOCUMENT_FACE_LIVENESS",
          "DOCUMENT_FACE_LIVENESS_NFC"
        ],
        "title": "VerificationLevel"
      }
    }
  }
}
