    "/v1/kyc/{session_id}/documents": {
      "post": {
        "summary": "Upload Document",
        "description": "Upload one side. Passports use DATA_PAGE; cards use FRONT and BACK.",
        "operationId": "upload_document_v1_kyc__session_id__documents_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Session Id"
            }
          },
          {
            "name": "X-API-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          },
          {
            "name": "X-Organization-ID",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Organization-Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_document_v1_kyc__session_id__documents_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaptureResponse"
                }
              }
            }
          },
          "409": {
            "description": "Session expired, closed, or not accepting document capture.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaptureError"
                }
              }
            }
          },
          "413": {
            "description": "Upload exceeds the size limit."
          },
          "422": {
            "description": "Unreadable or unsupported image, or a side this document type does not have."
          },
          "429": {
            "description": "Capture attempt limit reached for this session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaptureError"
                }
              }
            }
          },
          "503": {
            "description": "Capture storage is not configured."
          }
        }
      }
    },
