            "description": "Read checks.mrz, checks.mrz_consistency, the typed non-PII mrz object, review_flags and masked identity result. Conditional extraction tests do not claim processing completed; inspect status. GenericMRZAdapter has no independent visual-zone extraction and reports MRZ consistency NOT_APPLICABLE."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Result found\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Extraction leaves the decision null\", () => pm.expect(body.decision).to.eql(null));",
                  "pm.test(\"Masked number when extracted\", () => { if (body.document && body.document.document_number_masked) pm.expect(body.document.document_number_masked).to.match(/^\\*+[A-Z0-9]{4}$/); });",
                  "pm.test(\"MRZ metadata excludes raw identity values\", () => { if (body.mrz) { pm.expect(Object.keys(body.mrz).sort()).to.eql([\"check_digit_results\", \"field_consistency\", \"format\", \"mrz_valid\"]); Object.values(body.mrz.check_digit_results).forEach(digit => { pm.expect(Object.keys(digit).sort()).to.eql([\"computed\", \"expected\", \"valid\"]); pm.expect(digit.expected).to.match(/^[A-Z0-9<]$/); pm.expect(digit.computed).to.match(/^[0-9]$/); pm.expect(digit.valid).to.be.a(\"boolean\"); }); Object.values(body.mrz.field_consistency).forEach(state => pm.expect([\"MATCH\", \"MISMATCH\", \"MRZ_ONLY\", \"VIZ_ONLY\"]).to.include(state)); } if (body.document) pm.expect(body.document).to.not.have.property(\"document_number\"); });",
                  "pm.test(\"Completed extraction exposes MRZ outcome\", () => { if (body.status === \"SELFIE_REQUIRED\") pm.expect([\"PASS\", \"REVIEW\"]).to.include(body.checks.mrz); });",
                  "pm.test(\"Generic completed extraction has valid MRZ\", () => { if (body.status === \"SELFIE_REQUIRED\") pm.expect(body.checks.mrz).to.eql(\"PASS\"); });",
                  "pm.test(\"Parsed MRZ metadata has a supported format\", () => { if (body.mrz) { pm.expect([\"TD1\", \"TD2\", \"TD3\", \"UNKNOWN\"]).to.include(body.mrz.format); pm.expect(body.mrz.mrz_valid).to.be.a(\"boolean\"); } });",
                  "pm.test(\"Generic extraction has no independent visual comparison\", () => { if (body.status === \"SELFIE_REQUIRED\") pm.expect(body.checks.mrz_consistency).to.eql(\"NOT_APPLICABLE\"); });"
                ]
              }
            }
          ]
        }
      ]
    }
