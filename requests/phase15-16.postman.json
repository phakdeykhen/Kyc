          "path": [
            "v1",
            "webhooks"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"url\": \"https://169.254.169.254/latest\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Refused\", () => pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    },
    {
      "name": "Send test event",
      "request": {
        "method": "POST",
